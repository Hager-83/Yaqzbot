<?xml version="1.0"?>

<robot name="yakizbot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ================= PARAMETERS ================= -->
  <xacro:property name="base_length" value="0.40"/>
  <xacro:property name="base_width" value="0.295"/>
  <xacro:property name="base_height" value="0.20"/>

  <xacro:property name="wheel_radius" value="0.0425"/>
  <xacro:property name="wheel_width" value="0.038"/>

  <xacro:property name="track" value="0.28"/>
  <xacro:property name="wheelbase" value="0.15"/>

  <!-- ================= MATERIALS ================= -->
  <material name="blue"><color rgba="0 0 1 1"/></material>
  <material name="black"><color rgba="0 0 0 1"/></material>
  <material name="silver"><color rgba="0.79 0.82 0.93 1"/></material>

  <!-- ================= BASE ================= -->
  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="black"/>
    </visual>

    <collision>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>
  </link>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- ================= WHEELS (unchanged logic) ================= -->
  <xacro:macro name="wheel" params="name x_sign y_sign">
    <link name="${name}_wheel"/>
    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}_wheel"/>
      <origin xyz="${x_sign * wheelbase/2} ${y_sign * track/2} ${-base_height/2}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:wheel name="fl" x_sign="1" y_sign="1"/>
  <xacro:wheel name="rl" x_sign="-1" y_sign="1"/>
  <xacro:wheel name="fr" x_sign="1" y_sign="-1"/>
  <xacro:wheel name="rr" x_sign="-1" y_sign="-1"/>

  <!-- ================= IMU ================= -->
  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
  </joint>

  <!-- ================================================= -->
  <!-- ================= KINECT FIX ================= -->
  <!-- ================================================= -->

  <!-- Physical camera body -->
  <link name="kinect_link">
    <visual>
      <geometry>
        <box size="0.28 0.08 0.07"/>
      </geometry>
      <material name="blue"/>
    </visual>

    <collision>
      <geometry>
        <box size="0.28 0.08 0.07"/>
      </geometry>
    </collision>
  </link>

  <!-- FIX: only ONE mount transform -->
  <joint name="kinect_joint" type="fixed">
    <parent link="base_link"/>
    <child link="kinect_link"/>
    <origin xyz="0.15 0 0.25" rpy="0 0 0"/>
  </joint>

  <!-- Depth frame (sensor optical frame) -->
  <link name="kinect_depth"/>

  <joint name="kinect_depth_joint" type="fixed">
    <parent link="kinect_link"/>
    <child link="kinect_depth"/>

    <!-- FIX: must be identity transform (no offset) -->
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

</robot>