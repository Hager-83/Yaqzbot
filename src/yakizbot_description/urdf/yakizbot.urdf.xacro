<?xml version="1.0"?>

<!--
  URDF/Xacro model for a 4WD mobile robot (yakizbot)

  This file defines:
  - Robot physical dimensions (base + wheels)
  - Kinematic structure (links & joints)
  - Inertial properties for simulation/real control
  - IMU sensor mounting

  The robot is a 4-wheel drive (4WD) skid-steer platform.
-->

<robot name="yakizbot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ================= PARAMETERS ================= -->

  <!-- Base dimensions -->
  <xacro:property name="base_length"   value="0.40"/>
  <xacro:property name="base_width"    value="0.295"/>
  <xacro:property name="base_height"   value="0.20"/>

  <!-- Wheel dimensions -->
  <xacro:property name="wheel_radius"  value="0.0425"/>
  <xacro:property name="wheel_width"   value="0.038"/>

  <!-- Robot geometry -->
  <xacro:property name="track"         value="0.28"/>
  <xacro:property name="wheelbase"     value="0.15"/>


  <!-- ================= MATERIALS ================= -->

  <material name="blue">
    <color rgba="0 0 1 1"/>
  </material>

  <material name="black">
    <color rgba="0 0 0 1"/>
  </material>

  <material name="silver">
    <color rgba="0.79 0.82 0.93 1"/>
  </material>

  <material name="dark_grey">
    <color rgba="0.3 0.3 0.3 1"/>
  </material>


  <!-- ================================================= -->
  <link name="base_footprint"/>


  <!-- ================= BASE LINK ================= -->

  <link name="base_link">

    <visual>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="black"/>
    </visual>

    <collision>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.04"/>

      <mass value="3.0"/>

      <inertia
        ixx="0.05"
        ixy="0.0"
        ixz="0.0"
        iyy="0.05"
        iyz="0.0"
        izz="0.08"/>
    </inertial>

  </link>


  <!-- ================= BASE JOINT ================= -->

  <joint name="base_joint" type="fixed">

    <parent link="base_footprint"/>
    <child link="base_link"/>

    <!-- Lift robot body above ground -->
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>

  </joint>


  <!-- ================= WHEEL MACRO ================= -->

  <xacro:macro name="wheel" params="name x_sign y_sign">

    <!-- Wheel link -->
    <link name="${name}_wheel">

      <visual>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>

        <!-- Cylinder rotated so wheel looks correct -->
        <origin rpy="${pi/2} 0 0"/>

        <material name="blue"/>
      </visual>

      <collision>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>

        <origin rpy="${pi/2} 0 0"/>
      </collision>

      <inertial>
        <mass value="0.3"/>

        <inertia
          ixx="0.001"
          ixy="0"
          ixz="0"
          iyy="0.001"
          iyz="0"
          izz="0.001"/>
      </inertial>

    </link>


    <!-- Wheel joint -->
    <joint name="${name}_wheel_joint" type="continuous">

      <parent link="base_link"/>
      <child link="${name}_wheel"/>

      <!-- Wheel position -->
      <origin
        xyz="${x_sign * wheelbase/2}
             ${y_sign * track/2}
             ${-base_height/2}"
        rpy="0 0 0"/>


      <!-- ================================================= -->
      <!-- FIX: wheel rotation axis -->
      <!-- OLD (WRONG): axis xyz="0 0 1" -->
      <!-- NEW (CORRECT): axis xyz="0 1 0" -->
      <!-- -->
      <!-- Wheels rotate around Y axis in this URDF because -->
      <!-- cylinder visual is rotated using rpy="${pi/2} 0 0" -->
      <!-- ================================================= -->
      <axis xyz="0 1 0"/>


      <dynamics damping="0.01" friction="0.1"/>

    </joint>

  </xacro:macro>


  <!-- ================= WHEELS ================= -->

  <xacro:wheel name="front_left"  x_sign=" 1" y_sign=" 1"/>
  <xacro:wheel name="front_right" x_sign=" 1" y_sign="-1"/>
  <xacro:wheel name="rear_left"   x_sign="-1" y_sign=" 1"/>
  <xacro:wheel name="rear_right"  x_sign="-1" y_sign="-1"/>


  <!-- ================= IMU ================= -->

  <link name="imu_link">

    <visual>
      <geometry>
        <box size="0.03 0.03 0.01"/>
      </geometry>

      <material name="silver"/>
    </visual>

    <inertial>

      <mass value="0.05"/>

      <inertia
        ixx="0.0001"
        ixy="0"
        ixz="0"
        iyy="0.0001"
        iyz="0"
        izz="0.0001"/>

    </inertial>

  </link>


  <!-- IMU fixed to robot -->
  <joint name="imu_joint" type="fixed">

    <parent link="base_link"/>
    <child link="imu_link"/>

    <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>

  </joint>

</robot>

